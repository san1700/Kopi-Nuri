# Database (Neon pooled untuk runtime)
DATABASE_URL="postgresql://user:password@host:5432/kopi_nuri?sslmode=require"
# Database (Neon direct untuk migrasi Prisma)
DIRECT_URL="postgresql://user:password@host:5432/kopi_nuri?sslmode=require"

# Auth.js
AUTH_SECRET="generate-dengan-openssl-rand-base64-32"

# Vercel Cron
CRON_SECRET="generate-secret-random"

# WhatsApp Cloud API
WA_DRY_RUN="true"
WA_PHONE_NUMBER_ID=""
WA_ACCESS_TOKEN=""
WA_TEMPLATE_COMEBACK="comeback_template"
WA_API_VERSION="v21.0"
WA_WEBHOOK_VERIFY_TOKEN="kopi-nuri-wa-verify-token"

